{
    "display_information": {
        "name": "Codex Slack Bridge",
        "description": "Continue existing Codex conversations from Slack threads",
        "background_color": "#182430"
    },
    "features": {
        "bot_user": {
            "display_name": "Codex Bridge",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "channels:history",
                "groups:history"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "message.channels",
                "message.groups"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}
